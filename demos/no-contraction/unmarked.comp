#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Input {
    vec4 operands;
} source;
layout(set = 0, binding = 1, std430) buffer Output {
    float value;
} destination;
void main() {
    float product = source.operands.x * source.operands.y;
    float result = product + source.operands.z;
    destination.value = result;
}
